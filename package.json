{
  "name": "orammedia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "sanity": "sanity dev",
    "pams:generate": "prisma generate --generator client",
    "pams:generate:cloudflare": "prisma generate --generator cloudflare",
    "pams:migrate": "prisma migrate dev",
    "pams:seed": "tsx prisma/seed.ts",
    "pams:studio": "prisma studio",
    "postinstall": "prisma generate --generator client",
    "cf:build": "npm run cf:build:staging",
    "cf:build:staging": "NEXT_PUBLIC_SITE_URL=https://orammedia-staging.nasalifya007.workers.dev CF_ENV=staging PRISMA_GENERATOR=cloudflare opennextjs-cloudflare build",
    "cf:build:production": "NEXT_PUBLIC_SITE_URL=https://orammedia.com CF_ENV=production PRISMA_GENERATOR=cloudflare opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build:staging && opennextjs-cloudflare preview",
    "cf:deploy:staging": "npm run cf:build:staging && wrangler deploy --env staging",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply orammedia-staging --local",
    "d1:migrate:staging": "wrangler d1 migrations apply orammedia-staging --remote --env staging",
    "d1:seed:staging": "tsx scripts/seed-d1-staging.ts",
    "migrate:sqlite-to-d1": "tsx scripts/migrate-sqlite-to-d1.ts",
    "migrate:dam-to-r2": "tsx scripts/migrate-dam-to-r2.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@mux/mux-player-react": "^3.13.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.1.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.25",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-sanity": "^13.1.0",
    "next-video": "^2.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "sanity": "^6.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260717.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
